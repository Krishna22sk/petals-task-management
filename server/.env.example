# Petals Task Management — Backend Environment Variables (Production Ready)

PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://username:password@your-db-host:5432/petals_db?sslmode=require"

# JWT Authentication Secrets
JWT_SECRET=your_strong_random_jwt_secret_key_here
JWT_EXPIRES_IN=1d
REFRESH_SECRET=your_strong_random_refresh_secret_key_here
REFRESH_EXPIRES_IN=7d

# Production CORS Whitelist
FRONTEND_URL=https://YOUR-DOMAIN.COM

# Email & Notification Settings
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_password
EMAIL_FROM="Petals Automation" <no-reply@YOUR-DOMAIN.COM>

LOG_LEVEL=info
